# development | test | production
APP_ENV=development
CORS_ORIGINS=http://localhost:8501
# Required in production for audit and guardrail administration.
ADMIN_API_KEY=replace-with-a-long-random-value
# Enables deliberately unsafe before/after demos. Must remain false in production.
ALLOW_DEMO_BYPASS=false
# Raw prompts may contain PII. Enable only with an approved retention policy.
AUDIT_LOG_RAW_CONTENT=false
OLLAMA_URL=http://127.0.0.1:11434
